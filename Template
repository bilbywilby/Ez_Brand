Validation Script (Enhanced)
Save as validate_funding.py alongside your FUNDING.json:#!/usr/bin/env python3
"""Validate FUNDING.json for schema completeness, placeholder residue, and percentage math."""
import json, re, sys
from datetime import date, datetime

PLACEHOLDER_PATTERN = re.compile(r"\{\{[^}]+\}\}")
PERCENTAGE_FIELDS = [
    "infrastructure_costs_percentage",
    "developer_compensation_percentage",
    "community_support_percentage",
    "legal_and_compliance_percentage",
    "reserve_and_emergency_percentage",
]
DATE_FIELDS_PATTERNS = [
    r"^\d{4}-\d{2}-\d{2}$",
    r"^\d{4}$",
]

def load(path="FUNDING.json"):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        print(f"❌ File not found: {path}")
        sys.exit(1)
    except json.JSONDecodeError as e:
        print(f"❌ Invalid JSON: {e}")
        sys.exit(1)

def find_placeholders(obj, path="root"):
    issues = []
    if isinstance(obj, str):
        for m in PLACEHOLDER_PATTERN.finditer(obj):
            issues.append((path, m.group()))
    elif isinstance(obj, dict):
        for k, v in obj.items():
            issues.extend(find_placeholders(v, f"{path}.{k}"))
    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            issues.extend(find_placeholders(v, f"{path}[{i}]"))
    return issues

def validate_percentages(data):
    uf = data.get("use_of_funds_breakdown", {})
    total = sum(uf.get(f, 0) for f in PERCENTAGE_FIELDS)
    if total != 100:
        return [f"⚠️  Percentages sum to {total}, expected 100"]
    return []

def validate_urls(data):
    issues = []
    # spot-check key URLs
    repo = data.get("project", {}).get("repository_url", "")
    if repo and not repo.startswith(("http://", "https://")):
        issues.append(f"⚠️  repository_url is not a valid URL: {repo}")
    for opt in data.get("funding_options", []):
        if opt.get("active") is True:
            url = opt.get("profile_url", "")
            if url and not url.startswith(("http://", "https://")):
                issues.append(f"⚠️  profile_url for {opt.get('platform_type')} is not HTTPS")
    return issues

def main():
    data = load()
    all_issues = []

    # 1. Placeholder check
    ph_issues = find_placeholders(data)
    if ph_issues:
        for path, ph in ph_issues[:20]:  # show first 20
            all_issues.append(f"📌 Unfilled placeholder '{ph}' at {path}")
        if len(ph_issues) > 20:
            all_issues.append(f"... and {len(ph_issues) - 20} more unfilled placeholders")

    # 2. Percentage check
    all_issues.extend(validate_percentages(data))

    # 3. URL check
    all_issues.extend(validate_urls(data))

    # 4. Boolean placeholder check (str instead of bool)
    def check_bools(obj, path="root"):
        issues = []
        if isinstance(obj, dict):
            for k, v in obj.items():
                if k == "active" or k.startswith("has_") or k == "tax_deductible" or "boolean" in k.lower():
                    if isinstance(v, str) and v.strip() in ("{{true_or_false}}", "true", "false"):
                        issues.append(f"⚠️  Boolean field at {path}.{k} is a string, not a JSON boolean")
                if isinstance(v, (dict, list)):
                    p = f"{path}.{k}" if isinstance(v, dict) else f"{path}.{k}"
                    if isinstance(v, dict):
                        issues.extend(check_bools(v, p))
                    elif isinstance(v, list):
                        for i, item in enumerate(v):
                            if isinstance(item, dict):
                                issues.extend(check_bools(item, f"{p}[{i}]"))
        elif isinstance(obj, list):
            for i, v in enumerate(obj):
                if isinstance(v, dict):
                    issues.extend(check_bools(v, f"{path}[{i}]"))
        return issues

    all_issues.extend(check_bools(data))

    if all_issues:
        print(f"\nFound {len(all_issues)} issue(s):\n")
        for i in sorted(all_issues):
            print(f"  {i}")
        sys.exit(1)
    else:
        print("✅ FUNDING.json passes all checks")

if __name__ == "__main__":
    main()Run with: python3 validate_funding.py

Best Practice Recommendations
Security: Never store private keys, seed phrases, or derivation paths that could reconstruct a wallet. The hd_wallet_derivation_path field is informational only — it helps donors verify your setup, not reconstruct your wallet.
Boolean placeholders: The most common template error is leaving {{true_or_false}} as a string instead of replacing it with an actual JSON boolean (true / false). The validator above catches this.
Percentage arithmetic: All five *_percentage fields under use_of_funds_breakdown must sum to exactly 100. The validator enforces this.
Tier benefit stacking: In practice, higher tiers should implicitly include lower-tier benefits. The template models this with {{ALL_TIER_1_BENEFITS}} as a reference string. An alternative is to repeat the full benefit arrays at each tier — more verbose but machine-parseable.
Crypto addresses: Prefer Bech32 (bc1...) for Bitcoin, and consider subaddresses for Monero. Never reuse a personal wallet address; generate a dedicated donation address.
Tax disclaimer: Even if you're an individual, include a clear statement that donations are non-deductible unless you hold nonprofit status. The legal_disclaimer field exists for this purpose.

Recommended Workflow┌─────────────────────────────────────┐
│  1. Copy FUNDING.json.template       │
│  2. Fill all ✅ required placeholders │
│  3. Set active: false on unused       │
│     funding_options                   │
│  4. Adjust use_of_funds percentages  │
│     (must sum to 100)                │
│  5. Run python3 validate_funding.py   │
│  6. Set up .github/FUNDING.yml        │
│     (for GitHub Sponsors button)      │
│  7. Create GOVERNANCE.md             │
│  8. Create CONTRIBUTING.md            │
│  9. Set up financial reporting page   │
│ 10. Commit + push                     │
│ 11. Review quarterly (update dates!) │
└─────────────────────────────────────┘
