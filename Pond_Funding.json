📄 5. FUNDING.json (Universal Template){
  "schema_version": "1.0.0",
  "meta": {
    "template": "universal-foss-funding-template",
    "description": "Generic funding configuration for FOSS/GitHub projects. Customize all fields marked with '{{...}}'.",
    "usage_notes": [
      "Replace all {{placeholder}} values before publishing",
      "Remove unused funding_option types",
      "Add new funding_options as needed",
      "Keep all URLs valid and accessible"
    ]
  },
  "project": {
    "name": "{{PROJECT_NAME}}",
    "slug": "{{GITHUB_REPOSITORY_SLUG}}",
    "repository_url": "{{REPO_URL}}",
    "homepage_url": "{{HOMEPAGE_OR_DOCS_URL}}",
    "description_short": "{{SHORT_PROJECT_DESCRIPTION}}",
    "description_long": "{{DETAILED_PROJECT_DESCRIPTION}}",
    "maintainers": [
      {
        "github_username": "{{MAINTAINER_USERNAME_1}}",
        "role": "{{PRIMARY_MAINTAINER_OR_BDFL}}",
        "email_public": "{{OPTIONAL_CONTACT_EMAIL}}"
      }
    ],
    "started_date": "{{YYYY-MM-DD_OR_YEAR}}",
    "license_primary": {
      "spdx_id": "{{MIT/APACHE-2.0/GPL-3.0/etc}}",
      "url": "{{LICENSE_FILE_PATH_OR_URL}}",
